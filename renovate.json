{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeAll"
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "prConcurrentLimit": 2,
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "timezone": "Europe/Berlin",
  "packageRules": [
    {
      "description": "Use new devbox registry, see also https://github.com/jetify-com/devbox/issues/2965",
      "matchDatasources": ["devbox"],
      "registryUrls": ["https://www.nixsearch.com/v2/"]
    }
  ]
}
